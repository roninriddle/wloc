#!name=Apple WLOC 定位修改
#!desc=修改 Apple 网络定位返回坐标 | 控制台: https://roninriddle.github.io/wloc/
#!homepage=https://github.com/roninriddle/wloc
#!category=Tools
#!arguments=longitude:113.94114,latitude:22.544577,accuracy:25,randomRadius:0,logLevel:info
#!arguments-desc=经度/纬度: 默认坐标(网页写入后优先)\n精度: GPS精度(米)\n扰动半径: 每次响应在目标点周围随机偏移的最大距离(米)，0为关闭\n日志级别: off/error/warn/info/debug/all\n\n使用方法: 打开控制台 -> 选位置/收藏 -> 写入设备 -> iOS 26+ 按向导重启并验证

[Script]
Apple WLOC = type=http-response,pattern=^https?:\/\/(?:gs-loc(?:-cn)?\.apple\.com|gsp-ssl\.ls\.apple\.com|bluedot\.is\.autonavi\.com(?:\.gds\.alibabadns\.com)?)\/clls\/wloc,requires-body=1,binary-body-mode=1,max-size=0,timeout=30,script-path=https://raw.githubusercontent.com/roninriddle/wloc/main/wloc.js,argument=longitude={{{longitude}}}&latitude={{{latitude}}}&accuracy={{{accuracy}}}&randomRadius={{{randomRadius}}}&logLevel={{{logLevel}}}
WLOC Settings = type=http-request,pattern=^https?:\/\/gs-loc(?:-cn)?\.apple\.com\/wloc-settings\/save,requires-body=0,max-size=0,timeout=10,script-path=https://raw.githubusercontent.com/roninriddle/wloc/main/wloc-settings.js

[MITM]
hostname = %INSERT% gs-loc.apple.com, gs-loc-cn.apple.com, gsp-ssl.ls.apple.com, bluedot.is.autonavi.com, bluedot.is.autonavi.com.gds.alibabadns.com
